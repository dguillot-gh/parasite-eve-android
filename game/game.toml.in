# Android runtime config, written by the start menu after the user selects
# their own disc image (it fills the disc placeholder).
[game]
name = "Parasite Eve (USA) (Disc 1)"
id = "SLUS-00662"
players = 1
exe = "disc/SLUS_006.62"
discs = [
  @@DISC1@@,
  @@DISC2@@,
]
disc_serials = ["SLUS-00662", "SLUS-00668"]
load_address = "0x80010000"
entry_pc = "0x80072534"
text_size = "0x001EE000"
stack_base = "0x801FFFF0"

[recompiler]
seeds = "seeds/ghidra_funcs.txt"
out_dir = "generated"
strict = true

[runtime]
idle_skip = true
video_renderer = "software"
overlay_cache = true

[controller]
default_mode = "digital"

[bios]
path = "bios/openbios.bin"


[video]
renderer = "opengl"
gl_thread = true